app stream-chat [
  version: "1.0.0",
  description: "A streaming chat generate on a local OpenAI-compatible endpoint through std-llm.",
  egress: ["http://127.0.0.1:__PORT__"]
]
orbital ChatOrbital {
  uses Llm from "std/behaviors/std-llm"

  entity ChatRun [runtime] {
    id : string!
  }

  trait ChatLlm = Llm.traits.LlmClient -> ChatRun {
    config {
      provider: lmstudio
      origin: "http://127.0.0.1:__PORT__"
      basePath: "/v1"
      model: "recorded"
    }
  }

  page "/chat" as ChatPage -> ChatLlm
}
