# ===========================================
# Orbital Python Shell - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=3030
ENVIRONMENT=development

# ------------------------------------------
# Kernel Host (the native kernel runs the program and answers its own I/O)
# ------------------------------------------
# Where orbital_kernel.abi3.so is; default: ./kernel
# ORBITAL_KERNEL_DIR=./kernel
# The row store: mock (in memory, development only) | firebase | postgres | couchdb
NODE_ENV=development
DATA_BACKEND=mock
# DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require
# COUCHDB_URL=http://user:password@host:5984
# Credentials the program's services read are plain environment variables (see External Service API Keys below).
# Set ALMADAR_CREDENTIAL_MASTER_KEY to read them from the encrypted store in ALMADAR_CREDENTIALS_FILE first.

# ------------------------------------------
# Firebase Configuration
# ------------------------------------------
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate a new private key and use the values from the JSON file

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# For local development with Firebase Emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Alternative: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json

# ------------------------------------------
# External Service API Keys
# ------------------------------------------
# YouTube Data API v3 (for youtube integrator)
# YOUTUBE_API_KEY=your-youtube-api-key

# Stripe (for payment integrator)
# STRIPE_SECRET_KEY=sk_test_...

# Twilio (for messaging integrator)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Email Service (SendGrid/Resend)
# EMAIL_API_KEY=your-email-api-key
# EMAIL_FROM_ADDRESS=noreply@example.com

# AI API Keys (for AI integrators)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------
# ML Checkpoint Configuration
# ------------------------------------------
# Base URI relative checkpoint paths (checkpoint/save, checkpoint/load) are
# resolved against. Cloud Run's --min-instances 0 deploy target has an
# ephemeral filesystem, so the default (a relative local path) does NOT
# survive a cold start or redeploy — point this at a mounted volume for
# real persistence. Only the file:// scheme is implemented today; other
# schemes (gs://, s3://, ...) raise a clear error at save/load time.
# MODEL_CHECKPOINT_URI=file:///mnt/checkpoints
