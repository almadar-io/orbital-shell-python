# ===========================================
# Orbital Python Shell - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=3030
ENVIRONMENT=development

# ------------------------------------------
# Kernel Host (the native kernel runs the program and answers its own I/O)
# ------------------------------------------
# Where orbital_kernel.abi3.so is; default: ./kernel
# ORBITAL_KERNEL_DIR=./kernel
# The row store is declared by the app (`store:` with a std driver); no variable selects it.
NODE_ENV=development
# Credentials the program's services read are plain environment variables (see External Service API Keys below).
# Set ALMADAR_CREDENTIAL_MASTER_KEY to read them from the encrypted store in ALMADAR_CREDENTIALS_FILE first.

# ------------------------------------------
# Sign-in: who @user is
# ------------------------------------------
# This host is a server. A client signs its viewer in and sends the ID token as
# `Authorization: Bearer <token>`; the served program verifies it and binds @user.
# A request with no token is anonymous. The host verifies nothing and adds nothing.
# AUTH_PROVIDER must be set for any token to be accepted: firebase | oidc
# AUTH_PROVIDER=firebase
# firebase: tokens of this project (issuer https://securetoken.google.com/<project>)
# FIREBASE_PROJECT_ID=
# oidc (Auth0, Okta, Keycloak, Cognito, Clerk...): tokens verified against the issuer's keys
# OIDC_ISSUER_URL=https://your-tenant.example.com/
# OIDC_AUDIENCE=your-api-identifier

# Service account (Firestore and other Google services the program's store or services use)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# or: FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json

# Local dev on the Firebase emulators (never in production): unsigned emulator tokens are accepted
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ------------------------------------------
# External Service API Keys
# ------------------------------------------
# YouTube Data API v3 (for youtube integrator)
# YOUTUBE_API_KEY=your-youtube-api-key

# Stripe (for payment integrator)
# STRIPE_SECRET_KEY=sk_test_...

# Twilio (for messaging integrator)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Email Service (SendGrid/Resend)
# EMAIL_API_KEY=your-email-api-key
# EMAIL_FROM_ADDRESS=noreply@example.com

# AI API Keys (for AI integrators)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------
# ML Checkpoint Configuration
# ------------------------------------------
# Base URI relative checkpoint paths (checkpoint/save, checkpoint/load) are
# resolved against. Cloud Run's --min-instances 0 deploy target has an
# ephemeral filesystem, so the default (a relative local path) does NOT
# survive a cold start or redeploy — point this at a mounted volume for
# real persistence. Only the file:// scheme is implemented today; other
# schemes (gs://, s3://, ...) raise a clear error at save/load time.
# MODEL_CHECKPOINT_URI=file:///mnt/checkpoints
